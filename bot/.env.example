# ==============================================================================
# Tashqariga.uz Telegram Bot & WebApp sozlamalari
# ==============================================================================

# Telegram BotFather tomonidan berilgan token
BOT_TOKEN=7123456789:AAHAbcdefghijk123456789lmnopqrstuv

# Tashqariga WebApp URL manzili (Production yoki ngrok/localtunnel manzili)
# Eslatma: Telegram Web App ochilishi uchun URL HTTPS bo'lishi shart! (Localhostda ngrok orqali)
WEBAPP_URL=https://tashqariga.uz

# Bot username (boshida @ siz)
BOT_USERNAME=tashqariga_bot

# Yangi buyurtmalar va gid arizalari kelib tushadigan Admin/Kanal ID si
# O'zingizning shaxsiy Chat ID ingizni bilish uchun @userinfobot ga yozing
ADMIN_CHAT_ID=123456789

# Tashqariga CEO / Asosiy hamkorlik bo'limi telegram kontakti
CEO_TELEGRAM=@tashqariga_ceo

# WebApp va tashqi servislar uchun ichki REST API porti (Buyurtma bildirishnomalari uchun)
PORT=3001

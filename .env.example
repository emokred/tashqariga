# ==========================================
# Tashqariga.uz - Environment Variables Template
# Nusxa oling: cp .env.example .env.local
# ==========================================

# Asosiy domen manzili (oxirida / qo'yilmaydi)
NEXT_PUBLIC_APP_URL=https://tashqariga.uz

# Node Server sozlamalari
PORT=3000
NODE_ENV=production

# Telegram Bot / WebApp integratsiyasi (ixtiyoriy)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=tashqarigabot

# Web Analytics (Google Analytics / Yandex Metrika - ixtiyoriy)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
